<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Primary">#7C3AED</Color>
    <Color x:Key="Color.PrimaryHover">#6D28D9</Color>
    <Color x:Key="Color.Focus">#8B5CF6</Color>
    <Color x:Key="Color.Error">#DC2626</Color>
    <Color x:Key="Color.Success">#15803D</Color>
    <Color x:Key="Color.Background">#F6F7FB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceHover">#F0F1F6</Color>
    <Color x:Key="Color.SurfacePressed">#E7E9F1</Color>
    <Color x:Key="Color.PrimaryTint">#EDE9FE</Color>
    <Color x:Key="Color.TextPrimary">#171A24</Color>
    <Color x:Key="Color.TextSecondary">#5B6170</Color>
    <Color x:Key="Color.Border">#D8DCE6</Color>
    <Color x:Key="Color.OnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.ErrorText">#B91C1C</Color>
    <Color x:Key="Color.SuccessText">#166534</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.PrimaryTint" Color="{StaticResource Color.PrimaryTint}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="{StaticResource Color.SuccessText}" />
</ResourceDictionary>
