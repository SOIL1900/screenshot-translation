<UserControl x:Class="ScreenshotTranslation.App.Overlay.TranslationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenshotTranslation.App.Overlay"
             Height="400"
             AutomationProperties.Name="截图翻译结果面板">
    <Border Padding="16"
            Background="{DynamicResource Overlay.Brush.Panel}"
            BorderBrush="{DynamicResource Overlay.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              Direction="270"
                              Opacity="0.35"
                              ShadowDepth="2"
                              Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="112" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Overlay.Brush.TextSecondary}"
                           Text="翻译为" />
                <ComboBox x:Name="ScreenshotTargetLanguageInput"
                          Grid.Column="1"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding ScreenshotTargetLanguage, Mode=OneWay}"
                          SelectionChanged="OnScreenshotTargetLanguageChanged"
                          AutomationProperties.Name="截图翻译目标语言" />
                <Grid Grid.Column="3"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{DynamicResource Overlay.Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="检测到的截图源语言">
                        <Run Text="源语言：" />
                        <Run Text="{Binding DetectedSourceLanguage, Mode=OneWay, TargetNullValue=待检测, FallbackValue=待检测}" />
                    </TextBlock>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Width="52"
                                     Height="6"
                                     Margin="0,0,8,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsScreenshotLoadingVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="截图翻译进行中" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Overlay.Brush.TextSecondary}"
                                   Text="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
                <Button Grid.Column="4"
                        MinWidth="64"
                        Margin="8,0,0,0"
                        Content="重试"
                        Command="{Binding RetryScreenshotCommand}"
                        AutomationProperties.Name="重试截图翻译" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="截图译文" />
                    <TextBox MinHeight="72"
                             Padding="8"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Overlay.Brush.TextPrimary}"
                             IsReadOnly="True"
                             Text="{Binding ScreenshotTranslation, Mode=OneWay}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="截图译文" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="72"
                        Margin="12,26,0,0"
                        VerticalAlignment="Top"
                        Content="复制译文"
                        Command="{Binding CopyScreenshotCommand}"
                        AutomationProperties.Name="复制截图译文" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource Overlay.Brush.Border}" />

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="快捷回复" />
                        <TextBox x:Name="ReplyInput"
                                 Text="{Binding ReplyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnReplyInputPreviewKeyDown"
                                 AutomationProperties.Name="快捷回复输入" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource Overlay.Brush.TextSecondary}"
                                   Text="回复语言" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding ReplyTargetLanguage, Mode=TwoWay}"
                                  AutomationProperties.Name="回复目标语言" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="64"
                            Margin="0,25,0,0"
                            VerticalAlignment="Top"
                            Content="翻译"
                            Command="{Binding TranslateReplyCommand}"
                            AutomationProperties.Name="翻译快捷回复" />
                </Grid>

                <TextBlock Grid.Row="1"
                           MinHeight="24"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource Overlay.Brush.TextSecondary}"
                           Text="{Binding ReplyStatusMessage}"
                           AutomationProperties.LiveSetting="Polite" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Padding="8"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Overlay.Brush.TextPrimary}"
                             IsReadOnly="True"
                             Text="{Binding ReplyTranslation, Mode=OneWay}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="回复译文" />
                    <Button Grid.Column="1"
                            MinWidth="72"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            Content="复制回复"
                            Command="{Binding CopyReplyCommand}"
                            AutomationProperties.Name="复制回复译文" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource Overlay.Brush.ErrorText}"
                           Text="{Binding ClipboardError}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
