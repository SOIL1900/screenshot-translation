<UserControl x:Class="ScreenshotTranslation.App.Overlay.TranslationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxHeight="390"
             AutomationProperties.Name="截图翻译结果面板">
    <UserControl.Resources>
        <Style x:Key="OverlayCompactButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Overlay.Brush.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="#22222C" />
                    <Setter Property="BorderBrush" Value="#353542" />
                    <Setter Property="Foreground" Value="#A9A6B4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayAccentButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource OverlayCompactButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Overlay.Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Overlay.Brush.AccentHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.AccentHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Overlay.Brush.AccentHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayCompactComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{DynamicResource Overlay.Brush.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.Border}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Foreground="#FFFFFF"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            TextElement.Foreground="#FFFFFF">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          ContentSource="Content"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource Overlay.Brush.InputPressed}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource Overlay.Brush.PrimaryTint}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayCompactInputStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="{DynamicResource Overlay.Brush.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay.Brush.Border}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OverlayResultTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="144" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="{DynamicResource Overlay.Brush.Input}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="OverlayBandTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="OverlayMetaTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Overlay.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Border Padding="12"
            Background="{DynamicResource Overlay.Brush.Panel}"
            BorderBrush="{DynamicResource Overlay.Brush.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.42"
                              ShadowDepth="3"
                              Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="65" Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition MinHeight="76" Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="42" Height="Auto" />
                    <RowDefinition Height="23" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.RowSpan="2"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="截图翻译" Style="{StaticResource OverlayBandTitleStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource OverlayMetaTextStyle}"
                               AutomationProperties.Name="检测到的截图源语言">
                        <Run Text="源语言 · " />
                        <Run Text="{Binding DetectedSourceLanguage, Mode=OneWay, TargetNullValue=待检测, FallbackValue=待检测}" />
                    </TextBlock>
                </StackPanel>

                <ComboBox x:Name="ScreenshotTargetLanguageInput"
                          Grid.Row="0"
                          Grid.Column="1"
                          Margin="0,5,0,0"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding Languages}"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding ScreenshotTargetLanguage, Mode=OneWay}"
                          SelectionChanged="OnScreenshotTargetLanguageChanged"
                          Style="{StaticResource OverlayCompactComboBoxStyle}"
                          AutomationProperties.Name="截图翻译目标语言" />

                <TextBox x:Name="ScreenshotTranslationOutput"
                         Grid.Row="0"
                         Grid.Column="3"
                         Margin="0,5,0,0"
                         VerticalAlignment="Top"
                         Text="{Binding ScreenshotTranslation, Mode=OneWay}"
                         ToolTip="{Binding ScreenshotTranslation, Mode=OneWay}"
                         Style="{StaticResource OverlayResultTextBoxStyle}"
                         AutomationProperties.Name="截图译文" />
                <Grid Grid.Row="1"
                      Grid.Column="3"
                      Margin="2,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 Width="38"
                                 Height="3"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsScreenshotLoadingVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="截图翻译进行中" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource OverlayMetaTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <Button x:Name="RetryScreenshotButton"
                        Grid.Row="0"
                        Grid.Column="5"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding RetryScreenshotCommand}"
                        Style="{StaticResource OverlayCompactButtonStyle}"
                        AutomationProperties.Name="重试截图翻译">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="重试" />
                </Button>
                <Button x:Name="CopyScreenshotButton"
                        Grid.Row="0"
                        Grid.Column="7"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding CopyScreenshotCommand}"
                        Style="{StaticResource OverlayAccentButtonStyle}"
                        AutomationProperties.Name="复制截图译文">
                    <TextBlock Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               Text="复制" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0"
                    Background="{DynamicResource Overlay.Brush.Border}" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="52" Height="Auto" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.RowSpan="2"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="快捷回复" Style="{StaticResource OverlayBandTitleStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Enter 翻译"
                               Style="{StaticResource OverlayMetaTextStyle}" />
                </StackPanel>

                <TextBox x:Name="ReplyInput"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         VerticalAlignment="Top"
                         Text="{Binding ReplyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource OverlayCompactInputStyle}"
                         PreviewKeyDown="OnReplyInputPreviewKeyDown"
                         AutomationProperties.Name="快捷回复输入" />

                <ComboBox Grid.Row="0"
                          Grid.Column="3"
                          Margin="0,10,0,0"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding Languages}"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding ReplyTargetLanguage, Mode=TwoWay}"
                          Style="{StaticResource OverlayCompactComboBoxStyle}"
                          AutomationProperties.Name="回复目标语言" />

                <Button x:Name="TranslateReplyButton"
                        Grid.Row="0"
                        Grid.Column="5"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding TranslateReplyCommand}"
                        Style="{StaticResource OverlayCompactButtonStyle}"
                        AutomationProperties.Name="翻译快捷回复">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Text="翻译" />
                </Button>

                <TextBox x:Name="ReplyTranslationOutput"
                         Grid.Row="0"
                         Grid.Column="7"
                         Margin="0,10,0,0"
                         VerticalAlignment="Top"
                         Text="{Binding ReplyTranslation, Mode=OneWay}"
                         ToolTip="{Binding ReplyTranslation, Mode=OneWay}"
                         Style="{StaticResource OverlayResultTextBoxStyle}"
                         AutomationProperties.Name="回复译文" />
                <TextBlock Grid.Row="1"
                           Grid.Column="7"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ReplyStatusMessage}"
                           Style="{StaticResource OverlayMetaTextStyle}"
                           AutomationProperties.LiveSetting="Polite" />

                <Button Grid.Row="0"
                        Grid.Column="9"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding CopyReplyCommand}"
                        Style="{StaticResource OverlayAccentButtonStyle}"
                        AutomationProperties.Name="复制回复译文">
                    <TextBlock Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               Text="复制" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Overlay.Brush.ErrorText}"
                           FontSize="11.5"
                           Text="{Binding ClipboardError}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
