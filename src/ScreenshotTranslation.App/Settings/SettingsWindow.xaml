<Window x:Class="ScreenshotTranslation.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenshotTranslation.App.Settings"
        Title="截图翻译设置"
        Width="920"
        Height="650"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="截图翻译设置窗口">
    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="206" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="20,24,18,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.PrimaryTint}"
                            CornerRadius="10">
                        <Path Width="18"
                              Height="18"
                              Data="{StaticResource Icon.General}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Primary}"
                              StrokeThickness="1.8" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="截图翻译" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11.5"
                                   Text="偏好设置"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top"
                           Margin="32,0,0,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="设置" />

                <ListBox x:Name="NavigationList"
                         SelectedIndex="0"
                         SelectionChanged="OnNavigationSelectionChanged"
                         AutomationProperties.Name="设置页面导航">
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="常规设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.General}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="常规" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="模型设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.Model}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="模型" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="关于">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.About}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="关于" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <local:GeneralSettingsView x:Name="GeneralView" />
            <local:ModelSettingsView x:Name="ModelView" Visibility="Collapsed" />
            <local:AboutView x:Name="AboutView" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="28,12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock MinHeight="18"
                               Text="{Binding PageError}"
                               Style="{StaticResource ErrorStatusTextStyle}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock MinHeight="18"
                               Text="{Binding SaveStatusMessage}"
                               Style="{StaticResource SuccessStatusTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Width="76"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="正在保存…"
                               Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <Button MinWidth="92"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="保存设置">
                        <TextBlock Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   Text="保存设置" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
