<Window x:Class="ScreenshotTranslation.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenshotTranslation.App.Settings"
        Title="截图翻译设置"
        Width="820"
        Height="600"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="截图翻译设置窗口">
    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="截图翻译" />
                    <TextBlock Margin="0,4,0,0"
                               Text="设置"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <ListBox x:Name="NavigationList"
                         SelectedIndex="0"
                         SelectionChanged="OnNavigationSelectionChanged"
                         AutomationProperties.Name="设置页面导航">
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="常规设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.General}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="常规" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="模型设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.Model}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="模型" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationListBoxItemStyle}"
                                 AutomationProperties.Name="关于">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  Data="{StaticResource Icon.About}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.7" />
                            <TextBlock VerticalAlignment="Center" Text="关于" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <local:GeneralSettingsView x:Name="GeneralView" />
            <local:ModelSettingsView x:Name="ModelView" Visibility="Collapsed" />
            <local:AboutView x:Name="AboutView" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="24,14"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock MinHeight="20"
                               Text="{Binding PageError}"
                               Style="{StaticResource ErrorStatusTextStyle}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock MinHeight="20"
                               Text="{Binding SaveStatusMessage}"
                               Style="{StaticResource SuccessStatusTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Width="72"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="正在保存…"
                               Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <Button Content="保存"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="保存设置" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
