<UserControl x:Class="ScreenshotTranslation.App.Settings.HotkeyRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="34"
             Focusable="True"
             IsTabStop="True"
             AutomationProperties.Name="截图快捷键录制器"
             AutomationProperties.HelpText="聚焦后，同时按下修饰键和一个非修饰键来录制快捷键。"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <Border Padding="11,6"
            Background="{DynamicResource Brush.Surface}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                 Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock x:Name="DisplayTextBlock"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="当前快捷键" />
    </Border>
</UserControl>
