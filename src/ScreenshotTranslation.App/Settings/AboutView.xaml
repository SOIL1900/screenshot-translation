<UserControl x:Class="ScreenshotTranslation.App.Settings.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="关于截图翻译">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <TextBlock Text="关于" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Margin="0,0,0,24"
                       Text="截图翻译是一款面向游戏聊天场景的 Windows 桌面工具。"
                       Style="{StaticResource SecondaryTextStyle}" />

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="截图翻译" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ApplicationVersion}" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="许可证" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="MIT License" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开源说明" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="本项目采用 MIT License 开源。依赖信息可在源代码的项目文件中查阅。" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="隐私说明" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="API Key 以明文保存在当前用户的本机设置文件中。应用不会将截图、输入内容或译文写入诊断日志，也不包含遥测。"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
