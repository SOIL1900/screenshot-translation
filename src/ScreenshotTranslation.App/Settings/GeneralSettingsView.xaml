<UserControl x:Class="ScreenshotTranslation.App.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenshotTranslation.App.Settings"
             AutomationProperties.Name="常规设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <TextBlock Text="常规" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Margin="0,0,0,24"
                       Text="设置截图入口、默认翻译语言和应用外观。"
                       Style="{StaticResource SecondaryTextStyle}" />

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="截图与启动" Style="{StaticResource SectionHeaderTextStyle}" />

                    <StackPanel Margin="0,0,0,16">
                        <Label Target="{Binding ElementName=CaptureHotkeyInput}" Content="截图快捷键" />
                        <local:HotkeyRecorder x:Name="CaptureHotkeyInput"
                                              Tag="General.CaptureHotkey"
                                              Gesture="{Binding CaptureHotkey, Mode=TwoWay}"
                                              LostKeyboardFocus="OnFieldLostKeyboardFocus" />
                        <TextBlock Text="{Binding Errors[General.CaptureHotkey]}"
                                   Style="{StaticResource InlineValidationTextStyle}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Label Target="{Binding ElementName=TargetLanguageInput}" Content="默认截图翻译目标语言" />
                        <ComboBox x:Name="TargetLanguageInput"
                                  ItemsSource="{Binding Languages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding DefaultTargetLanguage, Mode=TwoWay}"
                                  AutomationProperties.Name="默认截图翻译目标语言" />
                        <TextBlock Text="框选截图后仍可临时切换目标语言。"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <CheckBox Margin="0,0,0,16"
                              Content="随 Windows 开机启动"
                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                              AutomationProperties.Name="随 Windows 开机启动" />

                    <StackPanel>
                        <Label Target="{Binding ElementName=ThemeInput}" Content="界面主题" />
                        <ComboBox x:Name="ThemeInput"
                                  ItemsSource="{Binding ThemeOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Theme, Mode=TwoWay}"
                                  AutomationProperties.Name="界面主题" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
